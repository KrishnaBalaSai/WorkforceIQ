# ==============================================================================
# WorkforceIQ – Environment Configuration Template
# Copy this file to .env and supply your local configuration.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# ── PostgreSQL Credentials (REQUIRED) ──────────────────────────────────────────
# POSTGRES_USER and POSTGRES_PASSWORD have no defaults.
# Docker Compose will refuse to start if either variable is missing or empty.
# Choose a strong, unique password — never use "postgres" in any environment.
#
# Example (do NOT use these exact values):
#   POSTGRES_USER=wiq_app
#   POSTGRES_PASSWORD=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">
POSTGRES_USER=<your_db_username>
POSTGRES_PASSWORD=<your_strong_db_password>
POSTGRES_DB=workforceiq

# ── PostgreSQL Connection URL ──────────────────────────────────────────────────
# Used by the FastAPI backend (SQLAlchemy engine).
# Host is "postgres" when running inside Docker Compose; "localhost" otherwise.
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
DB_URL=postgresql+psycopg2://<your_db_username>:<your_strong_db_password>@localhost:5432/workforceiq

# Connection Pool Sizing
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── FastAPI Backend Settings ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
LOG_LEVEL=info

# ── Security & Authentication (REQUIRED) ─────────────────────────────────────
# SECRET_KEY has no default. Docker Compose will refuse to start if it is missing.
# Generate a cryptographically strong key before running the application.
# Minimum 32 bytes of randomness. Treat this like a database password.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<generate_a_cryptographically_random_secret_key>

# ── HR Analytics Authorization Token (REQUIRED) ───────────────────────────────
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(64))"
HR_ANALYTICS_TOKEN=<generate_a_cryptographically_random_token>

# ── Data Directories (Relative to Project Root) ────────────────────────────────
DATA_GENERATED_DIR=data/generated
DATA_GROUND_TRUTH_DIR=data/ground_truth
DATA_MANIFESTS_DIR=data/manifests

# ── Streamlit Analytics Dashboard ──────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
BACKEND_API_URL=http://localhost:8000
