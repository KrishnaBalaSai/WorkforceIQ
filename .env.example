# ==============================================================================
# WorkforceIQ – Environment Configuration Template
# Copy this file to .env and supply your local configuration.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# ── PostgreSQL Connection ──────────────────────────────────────────────────────
# Required for production persistence.
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
DB_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/workforceiq

# Connection Pool Sizing
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── FastAPI Backend Settings ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
LOG_LEVEL=info

# ── Security & Authentication ──────────────────────────────────────────────────
# Set a 32+ byte cryptographic random secret in production
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# ── Data Directories (Relative to Project Root) ────────────────────────────────
DATA_GENERATED_DIR=data/generated
DATA_GROUND_TRUTH_DIR=data/ground_truth
DATA_MANIFESTS_DIR=data/manifests

# ── Streamlit Analytics Dashboard ──────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
BACKEND_API_URL=http://localhost:8000
